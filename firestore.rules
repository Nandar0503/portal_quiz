rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function adminOrTrainer() {
      return signedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin','trainer'];
    }
    match /knowledge/{id} {
      allow read: if true;
      allow create, update, delete: if adminOrTrainer();
    }
    match /categories/{id} {
      allow read: if true;
      allow write: if adminOrTrainer();
    }
    match /quizzes/{id} {
      allow read: if signedIn();
      allow write: if adminOrTrainer();
    }
    match /questions/{id} {
      allow read: if signedIn();
      allow write: if adminOrTrainer();
    }
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || adminOrTrainer());
      allow create: if signedIn() && request.auth.uid == uid;
      allow update: if signedIn() && (request.auth.uid == uid || adminOrTrainer());
      allow delete: if adminOrTrainer();
    }
    match /attempts/{id} {
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow read: if signedIn() && (resource.data.userId == request.auth.uid || adminOrTrainer());
      allow update, delete: if adminOrTrainer();
    }
    match /certificates/{id} {
      allow read: if true;
      allow create: if signedIn();
      allow update, delete: if adminOrTrainer();
    }
    match /activity_logs/{id} {
      allow create: if signedIn();
      allow read: if adminOrTrainer();
    }
  }
}
